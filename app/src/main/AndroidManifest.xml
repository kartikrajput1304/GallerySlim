<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13+ granular media permissions -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14 partial photo access -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Android 12 fallback -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Keep original GPS EXIF visible to the scanner -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- Overnight batch: long-running WorkManager worker promoted to a dataSync FGS -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 15+: transcoding runs as a media-processing foreground service (falls back to dataSync below 35). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <!-- Progress + morning-summary notifications (runtime permission on 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional app lock (platform BiometricPrompt) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Send-to-laptop (developer sign-off 2026-10-20): local Wi-Fi only — the server
         binds to the Wi-Fi address and refuses non-private peers; every connection is logged. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Answers the friendly name galleryslim.local on the Wi-Fi while sharing -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Design §6 rule 6: detect Google Photos to warn about re-upload of shrunk files -->
    <queries>
        <package android:name="com.google.android.apps.photos" />
    </queries>

    <!-- No cloud backup and no device-to-device transfer (C1 + privacy): the shrink ledger names
         MediaStore _IDs, which mean other photos on another device or after a MediaStore rebuild. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.GallerySlim"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hosts the send-to-laptop page while a share is active -->
        <service
            android:name=".share.ShareService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Held while an in-app batch runs so leaving the app doesn't freeze it -->
        <service
            android:name=".shrinkflow.BatchKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />

        <!-- Shares only files/logs/ (see res/xml/diag_paths.xml) for "Share diagnostic log" -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diag"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diag_paths" />
        </provider>

        <!-- "Share small" entry in Android's share menu: reads the shared items, never changes them. -->
        <activity
            android:name=".sharesmall.ShareSmallActivity"
            android:exported="true"
            android:label="Share small"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.GallerySlim">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".storage.StorageWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/storage_widget_info" />
        </receiver>

        <!-- WorkManager's foreground service needs the dataSync type on API 34+ -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|mediaProcessing"
            tools:node="merge" />
    </application>
</manifest>
